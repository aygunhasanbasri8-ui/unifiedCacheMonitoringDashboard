      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "pm.environment.set(\"token\", json.token);\r",
                  "\r",
                  "pm.test(\"Status 200 döndü\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Token boş değil\", () => pm.expect(json.token).to.not.be.empty);\r",
                  "pm.test(\"Rol MONITOR\", () => pm.expect(json.role).to.eql(\"MONITOR\"));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
