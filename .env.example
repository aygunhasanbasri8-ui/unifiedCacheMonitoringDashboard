# Bu dosyayı .env olarak kopyalayın ve değerleri kendinizinkilerle değiştirin.
#   cp .env.example .env
#
# JWT imzalama anahtarı — ZORUNLU, en az 32 karakter.
# Üretmek için:  openssl rand -base64 48
JWT_SECRET=degistirin-bu-deger-en-az-32-karakter-olmalidir

# Varsayılan dev kullanıcılarının parolaları — ZORUNLU
# (APP_ENVIRONMENT=production değilse uygulama bunlar olmadan açılmaz).
# UI'a bu kullanıcılarla giriş yapılır: monitor / admin
TEST_USER_MONITOR_PASSWORD=monitor123
TEST_USER_ADMIN_PASSWORD=admin123
