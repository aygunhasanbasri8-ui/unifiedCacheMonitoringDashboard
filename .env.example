# Bu dosyayı .env olarak kopyalayın ve değerleri kendinizinkilerle değiştirin.
#   cp .env.example .env
#
# JWT imzalama anahtarı — ZORUNLU, en az 32 karakter.
# Üretmek için:  openssl rand -base64 48
JWT_SECRET=degistirin-bu-deger-en-az-32-karakter-olmalidir

# İlk açılışta oluşturulan TEK yönetici hesabı — ZORUNLU.
# Uygulamaya bu hesapla girilir; diğer kullanıcılar UI'daki kullanıcı
# yönetimi ekranından açılır. Kodda gömülü varsayılan kullanıcı yoktur.
#
# Not: hesap veritabanında zaten varsa bu değerler yok sayılır —
# parola değiştirmek için hesabı silip uygulamayı yeniden başlatın.
UCMD_BOOTSTRAP_USERNAME=admin
UCMD_BOOTSTRAP_PASSWORD=degistirin-guclu-bir-parola
UCMD_BOOTSTRAP_ROLE=ADMIN

# PostgreSQL kimlik bilgileri — hem postgres hem ucmd-backend servisi kullanır.
POSTGRES_USER=ucmd_user
POSTGRES_PASSWORD=degistirin-guclu-bir-parola

# Grafana admin hesabı (sadece Docker Compose ortamı)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=degistirin-guclu-bir-parola

# Redis-cache (redis-2) şifresi
REDIS_CACHE_PASSWORD=degistirin-guclu-bir-parola
